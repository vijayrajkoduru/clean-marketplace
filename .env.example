# Copy this file to .env and fill in the values.

# Database. SQLite file for local development and a single small server.
DATABASE_URL="file:./dev.db"

# Public address of the site, used in links, SMS and payment callbacks.
APP_URL="http://localhost:3000"

# Phone numbers (10 digits, comma separated) that become admins when they log in.
ADMIN_PHONES="9000000000"

# SMS for login codes: "console" prints codes in the server log (testing only),
# "msg91" sends real SMS through MSG91 (needs a DLT-approved OTP template).
SMS_PROVIDER="console"
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""

# Online payments through Razorpay. Leave empty to offer only "Pay after service".
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
