# Copy this file to .env and fill in the values.

# Database. SQLite file for local development and a single small server.
DATABASE_URL="file:./dev.db"

# Public address of the site, used in links, SMS and payment callbacks.
APP_URL="http://localhost:3000"

# Phone numbers (10 digits, comma separated) that become admins when they log in.
ADMIN_PHONES="9000000000"

# SMS for login codes: "console" prints codes in the server log (testing only),
# "msg91" sends real SMS through MSG91 (needs a DLT-approved OTP template).
SMS_PROVIDER="console"
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""

# Online payments through Razorpay. Leave empty to offer only "Pay after service".
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Booking updates on WhatsApp (Meta WhatsApp Cloud API). Leave empty to show them only on the site.
# WHATSAPP_TEMPLATE is an approved utility template with one body variable, for example
# "Update from Clean: {{1}}".
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_TEMPLATE=""
WHATSAPP_TEMPLATE_LANGUAGE="en"

# Android app from the Play Store (see D:\clean-app\twa\README.md). The package name, and the
# SHA-256 fingerprints of the app signing key and upload key from Play Console, comma separated.
ANDROID_APP_PACKAGE=""
ANDROID_CERT_SHA256=""
